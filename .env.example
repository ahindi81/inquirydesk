# Copy this file to .env.local and fill in the values ON YOUR COMPUTER / HOSTING.
# Never paste these values into a chat, email or the repository.

# --- Supabase (Project Settings → API / Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Connection pooler string, "Transaction" mode (port 6543), with your database password:
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

AUTH_DRIVER=supabase
STORAGE_DRIVER=supabase

# --- AI (optional). Without it, the rule-based reader is used and labelled as such. ---
# An Anthropic API account is separate from a Claude subscription: console.anthropic.com
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# --- Limits (optional) ---
# AI_RUNS_PER_USER_PER_HOUR=30
# UPLOADS_PER_USER_PER_HOUR=200
# AI_MAX_INPUT_CHARS=400000
